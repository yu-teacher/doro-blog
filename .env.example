# ==============================================================================
# DORO Blog Server Environment Variables Template
# 미니 서버 배포 시 이 파일을 .env로 복사하여 환경에 맞게 값을 설정하세요.
# ==============================================================================

# 1. Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=25432
DB_NAME=service_blog
DB_USER=doro_admin
DB_PASSWORD=change-me

# 2. DORO IAM (인증 서비스)
IAM_HOST=localhost
IAM_PORT=28080

# 3. DORO Guard (ReBAC 권한 인가 서비스)
GUARD_GRPC_HOST=localhost
GUARD_GRPC_PORT=9090
GUARD_HTTP_HOST=localhost
GUARD_HTTP_PORT=28081

# 4. MinIO Object Storage (이미지/미디어 스토리지)
# 서버 내부 통신 주소 (Spring Boot -> MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=doro_admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=doro-blog-media
# 클라이언트 브라우저가 이미지를 요청할 공개 주소 (상대 경로 권장: /media)
MINIO_PUBLIC_URL=/media

# 5. Frontend & Web Portal
# DORO 통합 포털 주소 (회원가입, 중앙 대시보드)
VITE_DORO_PORTAL_URL=http://localhost:3000
