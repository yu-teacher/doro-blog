# DORO Blog Web Environment Variables
# In production / mini server, set these to match your domain or internal service URL

# DORO Central Portal (Web UI) URL
VITE_DORO_PORTAL_URL=http://localhost:3000

# Backend API Base (defaults to relative /api/v1 for reverse proxy setups)
VITE_API_BASE_URL=/api/v1

# Media Object Storage Base (defaults to relative /media for reverse proxy setups)
VITE_MEDIA_BASE_URL=/media
